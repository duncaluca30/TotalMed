generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())

  twoFactorSecret String?
  isTwoFactorEnabled Boolean @default(false)

  emailOtpCode       String?
  emailOtpExpiresAt  DateTime?
  webAuthnChallenge  String?

  lastLoginIp       String?
  lastLoginDevice   String?

  patientProfile Patient?
  doctorProfile  Doctor?
  passkeys       Passkey[]
}

model Patient {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime
  phone       String?
  accessCode    AccessCode?

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  allergies      Allergy[]
  medications    Medication[]
}

model Doctor {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  specialty     String
  licenseNumber String   @unique

  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
}

model Appointment {
  id        String            @id @default(uuid())
  dateTime  DateTime
  status    AppointmentStatus @default(SCHEDULED)
  reason    String?

  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])

  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
}

model MedicalRecord {
  id          String   @id @default(uuid())
  diagnosis   String
  treatment   String?
  notes       String?
  createdAt   DateTime @default(now())

  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
}

// Patient-level allergy. Sensitive text fields (substance, reaction) are stored
// encrypted at rest, like MedicalRecord. Severity is a plaintext enum so it stays
// queryable and is not patient-identifying on its own.
model Allergy {
  id        String          @id @default(uuid())
  substance String
  reaction  String?
  severity  AllergySeverity @default(MODERATE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  patientId String
  patient   Patient         @relation(fields: [patientId], references: [id])
}

// Patient-level current medication. Text fields are stored encrypted at rest.
model Medication {
  id        String   @id @default(uuid())
  name      String
  dosage    String?
  frequency String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model AccessCode {
  id        String   @id @default(uuid())
  code      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Passkey {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  webauthnUserId      String
  credentialId        String
  credentialPublicKey Bytes
  counter             Int
  deviceType          String
  backedUp            Boolean
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   
  action    String   
  details   String?  
  ipAddress String?
  createdAt DateTime @default(now())
}