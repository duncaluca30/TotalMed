generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum BirthModality {
  NATURAL
  CESAREAN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())

  twoFactorSecret String?
  isTwoFactorEnabled Boolean @default(false)

  // Single-use 2FA recovery codes, stored as SHA-256 hashes. A used code is
  // removed from the array so it can never be replayed.
  twoFactorBackupCodes String[] @default([])

  emailOtpCode       String?
  emailOtpExpiresAt  DateTime?
  webAuthnChallenge  String?

  // Password reset: we store only the SHA-256 hash of the emailed token, so a DB
  // leak can't be used to reset accounts.
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?

  // Email verification. Defaults to true so existing accounts stay usable; new
  // registrations are created with false until the emailed link is opened.
  isEmailVerified            Boolean   @default(true)
  emailVerificationToken     String?
  emailVerificationExpiresAt DateTime?

  // Any JWT issued before this instant is rejected by the auth middleware. Bumped
  // on password reset/change to log the account out everywhere.
  sessionValidAfter DateTime?

  lastLoginIp       String?
  lastLoginDevice   String?

  patientProfile Patient?
  doctorProfile  Doctor?
  passkeys       Passkey[]
}

model Patient {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime
  cnp         String?  @unique
  phone       String?
  sex         Sex?
  accessCode    AccessCode?

  // Gynecological / obstetric history — only relevant when sex == FEMALE.
  // Individual births are tracked in the Birth model below.
  menarcheDate DateTime?
  atMenopause  Boolean  @default(false)

  // Emergency Medical ID — an opt-in, minimal "in case of emergency" profile a
  // first responder can read without logging in, via an unguessable token URL.
  // Free-text fields are encrypted at rest; the card is only served when
  // emergencyEnabled is true. emergencyId is the bearer capability in the URL.
  bloodType            String?  // encrypted
  emergencyContactName String?  // encrypted
  emergencyContactPhone String? // encrypted
  emergencyId          String?  @unique
  emergencyEnabled     Boolean  @default(false)

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])

  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  allergies        Allergy[]
  medications      Medication[]
  births           Birth[]
  emergencyAccesses EmergencyAccess[]
  vitalSigns       VitalSign[]
  vaccinations     Vaccination[]
}

// A single immunization in the patient's history. Vaccine name and notes are
// encrypted at rest; the structured date/dose fields stay typed and chartable.
model Vaccination {
  id           String    @id @default(uuid())
  vaccineName  String    // encrypted
  date         DateTime
  doseNumber   Int?
  nextDoseDate DateTime?
  notes        String?   // encrypted
  createdAt    DateTime  @default(now())

  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id])
}

// A single time-stamped vital-sign measurement. Values are numeric and
// structured (non-identifying on their own), so — like Birth.year and
// AllergySeverity — they are stored as plain typed columns rather than encrypted
// text, which also keeps them directly chartable. For BLOOD_PRESSURE, `value` is
// systolic and `value2` is diastolic.
model VitalSign {
  id         String   @id @default(uuid())
  type       String   // BLOOD_PRESSURE | WEIGHT | GLUCOSE | HEART_RATE | TEMPERATURE
  value      Float
  value2     Float?
  unit       String
  measuredAt DateTime
  createdAt  DateTime @default(now())

  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])

  @@index([patientId, type])
}

model Doctor {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  specialty     String
  licenseNumber String   @unique

  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])

  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  emergencyAccesses EmergencyAccess[]
  amendments       Amendment[]
}

// A reminder on the patient's calendar (e.g. "Cardiology check-up · 12.06.2027 ·
// Clinica Sfânta Maria"), NOT a clinic booking. The patient manages these; a
// doctor can also add one while in the vault (doctorId records who created it).
// Free-text fields are stored encrypted at rest.
model Appointment {
  id        String            @id @default(uuid())
  dateTime  DateTime
  status    AppointmentStatus @default(SCHEDULED)
  specialty String?
  location  String?
  reason    String?

  // Set once a 24h-ahead reminder email has been sent, so the daily job never
  // emails the same appointment twice.
  reminderSentAt DateTime?

  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])

  doctorId  String?
  doctor    Doctor?  @relation(fields: [doctorId], references: [id])
}

model MedicalRecord {
  id          String   @id @default(uuid())
  diagnosis   String
  treatment   String?
  notes       String?
  // Optional ICD-10 code for the diagnosis. Encrypted at rest like the diagnosis
  // text itself, so a DB leak can't reveal coded diagnoses either.
  icdCode     String?
  createdAt   DateTime @default(now())

  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])

  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id])

  attachments Attachment[]
  amendments  Amendment[]
}

// An append-only correction/addendum to a medical record. Records themselves are
// never edited (integrity); a doctor adds a dated amendment instead, preserving
// the original text alongside the correction. Text is encrypted at rest.
model Amendment {
  id        String        @id @default(uuid())
  text      String        // encrypted
  createdAt DateTime      @default(now())

  recordId  String
  record    MedicalRecord @relation(fields: [recordId], references: [id])

  doctorId  String
  doctor    Doctor        @relation(fields: [doctorId], references: [id])
}

// A file (lab result, imaging, discharge letter…) attached to a medical record.
// The bytes and the original file name are encrypted at rest; mimeType and
// sizeBytes stay plaintext so the UI can render a chip without decrypting.
// Attachments inherit the consent of their parent record: a doctor only ever
// receives the metadata for records the patient chose to share, and the bytes
// are streamed on demand behind the same authorisation checks.
model Attachment {
  id        String   @id @default(uuid())
  fileName  String   // encrypted
  mimeType  String
  sizeBytes Int
  data      Bytes    // encrypted blob (iv | authTag | ciphertext)
  createdAt DateTime @default(now())

  recordId  String
  record    MedicalRecord @relation(fields: [recordId], references: [id])
}

// Patient-level allergy. Sensitive text fields (substance, reaction) are stored
// encrypted at rest, like MedicalRecord. Severity is a plaintext enum so it stays
// queryable and is not patient-identifying on its own.
model Allergy {
  id        String          @id @default(uuid())
  substance String
  reaction  String?
  severity  AllergySeverity @default(MODERATE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  patientId String
  patient   Patient         @relation(fields: [patientId], references: [id])
}

// Patient-level current medication. Text fields are stored encrypted at rest.
model Medication {
  id        String   @id @default(uuid())
  name      String
  dosage    String?
  frequency String?
  // When true, the patient receives a daily reminder email for this medication.
  reminderEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
}

// A single birth in a patient's obstetric history. Modality and year are
// structured (non-identifying) values, so — like AllergySeverity — they are
// stored as typed columns rather than encrypted text. The number of births is
// simply the count of these rows.
model Birth {
  id        String        @id @default(uuid())
  modality  BirthModality
  year      Int?
  createdAt DateTime      @default(now())

  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id])
}

model AccessCode {
  id        String   @id @default(uuid())
  code      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Passkey {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  webauthnUserId      String
  credentialId        String
  credentialPublicKey Bytes
  counter             Int
  deviceType          String
  backedUp            Boolean
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  // Tamper-evidence: each entry stores the hash of the previous entry plus a
  // hash of its own fields, forming an append-only chain. Editing or deleting a
  // row breaks the chain, which the admin "verify integrity" check detects.
  prevHash  String?
  entryHash String?
}

// Records every break-the-glass access so the patient can be notified post-hoc
// and administrators can audit the use of emergency override.
model EmergencyAccess {
  id          String    @id @default(uuid())
  reason      String
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  doctorId    String
  doctor      Doctor    @relation(fields: [doctorId], references: [id])
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id])
}

// In-app notification for any user (patient or doctor). Persisted so the user
// has a durable history of everything that touched their account, complementing
// the transient Socket.IO events and the security emails.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // RECORD_ADDED | EMERGENCY_ACCESS | NEW_LOGIN | VAULT_ACCESSED
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}