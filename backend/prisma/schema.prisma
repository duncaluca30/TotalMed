generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())

  twoFactorSecret String?
  isTwoFactorEnabled Boolean @default(false)

  emailOtpCode       String?
  emailOtpExpiresAt  DateTime?
  webAuthnChallenge  String?

  patientProfile Patient?
  doctorProfile  Doctor?
  passkeys       Passkey[]
}

model Patient {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime
  phone       String?
  accessCode    AccessCode?

  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
}

model Doctor {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  specialty     String
  licenseNumber String   @unique

  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
}

model Appointment {
  id        String            @id @default(uuid())
  dateTime  DateTime
  status    AppointmentStatus @default(SCHEDULED)
  reason    String?

  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])

  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
}

model MedicalRecord {
  id          String   @id @default(uuid())
  diagnosis   String
  treatment   String?
  notes       String?
  createdAt   DateTime @default(now())

  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id])
}

model AccessCode {
  id        String   @id @default(uuid())
  code      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model Passkey {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  webauthnUserId      String   // Unique identifier for the credential
  credentialId        String   // Unique to the authenticator
  credentialPublicKey Bytes    // Public key to verify signatures
  counter             Int      // Increments each time the authenticator is used
  deviceType          String
  backedUp            Boolean
}